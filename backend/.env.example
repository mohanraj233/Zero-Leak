# ZeroLeak Backend Gateway Environment Configuration

PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Neon PostgreSQL Database Connection
# Pooled connection string for queries
DATABASE_URL=postgresql://neondb_owner:npg_placeholder@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct connection string for schema migrations
DIRECT_DATABASE_URL=postgresql://neondb_owner:npg_placeholder@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Internal Python FastAPI File Processing & Presidio Service
PRESIDIO_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=zeroleak_internal_secret_token_128bit

# Authentication & Security
JWT_SECRET=zeroleak_jwt_signing_secret_min_32_characters_random
JWT_EXPIRES_IN=7d

# File Storage & Limits
MAX_UPLOAD_MB=15
UPLOAD_TEMP_DIR=./temp_uploads
SANITIZED_DIR=./temp_sanitized

# ZeroLeak Policy & Lifecycles
MAPPING_TTL_SECONDS=300
HISTORY_ENABLED=true
FAIL_CLOSED=true
RATE_LIMIT_MAX_PER_MINUTE=60
